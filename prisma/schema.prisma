generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db/custom.db"
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  projectType String   // luxury-home, commercial, marine, classic-auto
  serviceType String   // full-reupholstery, custom-build, repair
  photos      String   @default("[]") // JSON array of photo URLs
  message     String   @default("")
  leadScore   Int      @default(0)
  status      String   @default("new") // new, contacted, qualified, converted, lost
  source      String   @default("website") // website, designer-portal, qr-code
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DesignerInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String
  phone     String
  portfolio String   @default("")
  message   String   @default("")
  status    String   @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
